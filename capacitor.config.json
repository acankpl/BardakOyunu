{
  "appId": "com.akdenizterasi.masavebardak",
  "appName": "Akdeniz Bardak",
  "webDir": "www",
  "bundledWebRuntime": false,
  "backgroundColor": "#0b3b3c",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "allowNavigation": []
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": false
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    }
  }
}

